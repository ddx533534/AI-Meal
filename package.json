{
  "name": "ai-meal-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/netlify-dev.mjs --offline",
    "check": "tsc --noEmit",
    "build": "netlify build --offline",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "node scripts/netlify-deploy.mjs",
    "test": "node --test tests/*.test.mjs",
    "pretest": "npm run build:worker && npm run build:test-runtime",
    "preverify:live": "npm run build:test-runtime",
    "verify:live": "node scripts/netlify-live-smoke.mjs",
    "request:local": "node scripts/request-local.mjs",
    "verify:cloud": "node scripts/cloud-smoke.mjs --netlify",
    "dev:worker": "wrangler dev --local",
    "build:worker": "wrangler deploy --dry-run --outdir dist",
    "deploy:worker": "wrangler deploy",
    "verify:live:worker": "node scripts/live-smoke.mjs",
    "preverify:live:worker": "npm run build:worker",
    "verify:cloud:worker": "node scripts/cloud-smoke.mjs",
    "build:test-runtime": "node scripts/build-netlify-test.mjs",
    "predev:meal": "npm run build:test-runtime",
    "dev:meal": "node scripts/meal-picker-dev.mjs",
    "preverify:meal:live": "npm run build:test-runtime",
    "verify:meal:live": "node scripts/meal-picker-live.mjs",
    "preverify:meal:cloud": "npm run build:test-runtime",
    "verify:meal:cloud": "node scripts/meal-picker-live.mjs --cloud"
  },
  "dependencies": {
    "@google/adk": "2.2.1",
    "@google/genai": "2.28.0",
    "@modelcontextprotocol/sdk": "1.27.1",
    "@netlify/blobs": "11.1.3",
    "@netlify/functions": "6.0.2",
    "ajv": "8.17.1",
    "zod": "4.6.5"
  },
  "overrides": {
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "@opentelemetry/sdk-trace-node": "2.11.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261008.1",
    "esbuild": "0.28.1",
    "miniflare": "5.20261006.0-alpha",
    "netlify-cli": "27.11.2",
    "typescript": "5.9.3",
    "wrangler": "4.148.0"
  }
}
